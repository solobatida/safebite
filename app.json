{
  "expo": {
    "name": "Safe Bite",
    "slug": "safebite",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "safebite",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.safebite.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Safe Bite uses the camera to scan barcodes and read ingredient labels.",
        "NSPhotoLibraryUsageDescription": "Safe Bite can read an ingredient-label photo from your library.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.safebite.app",
      "permissions": [
        "CAMERA",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#1E7A47",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Safe Bite to scan barcodes on food packages."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Safe Bite to read ingredient labels from photos.",
          "cameraPermission": "Allow Safe Bite to photograph ingredient labels."
        }
      ],
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7e34393a-21d7-4d4f-a30d-91196d8d3c0e"
      }
    }
  }
}
