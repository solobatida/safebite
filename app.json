{
  "expo": {
    "name": "Come Tranki",
    "slug": "safebite",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "safebite",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.safebite.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Come Tranki uses the camera to scan product barcodes in the supermarket.",
        "NSPhotoLibraryUsageDescription": "Optional: save product scan history.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.safebite.app",
      "permissions": [
        "CAMERA",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#1E7A47",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Come Tranki to scan barcodes on food packages."
        }
      ],
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7e34393a-21d7-4d4f-a30d-91196d8d3c0e"
      }
    }
  }
}
