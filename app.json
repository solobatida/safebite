{
  "expo": {
    "name": "SafeBite",
    "slug": "safebyte",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "safebyte",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.safebyte.app",
      "infoPlist": {
        "NSCameraUsageDescription": "SafeBite uses the camera to scan product barcodes in the supermarket.",
        "NSPhotoLibraryUsageDescription": "Optional: save product scan history."
      }
    },
    "android": {
      "package": "com.safebyte.app",
      "permissions": ["CAMERA"],
      "adaptiveIcon": {
        "backgroundColor": "#1B5E3B",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow SafeBite to scan barcodes on food packages."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
